# AI API 配置
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=your_token_here

# 点评评价图片来源链的生图凭据（new-api 站 api.mangoqwq.com，模型固定 gpt-image-2）。
# 不设置时 resolve_review_photos 跳过生图、直接回落默认图；key 只走 env，不入库。
# CLI 启动时会读取仓库根 `.env`（env.py load_dotenv）；已 export 的变量优先。
DIANPING_GEN_API_KEY=sk-your_image_key_here
DIANPING_GEN_BASE_URL=https://api.mangoqwq.com/v1
DIANPING_GEN_IMAGE_MODEL=gpt-image-2
# slidex 风控视觉通道（--enable-slidex 时点选/字符图形验证码的多模态识别引擎）。
# 不配置时滑块仍可用（纯图像引擎），但点选/字符类验证码会返回 vision_not_configured。
# 模型必须是网关 /v1/models 实测可用的多模态 chat 模型。
SLIDEX_VISION_ENDPOINT=https://api.mangoqwq.com/v1/chat/completions
SLIDEX_VISION_API_KEY=sk-your_vision_key_here
SLIDEX_VISION_MODEL=gemini-3.8-flash
