# AI API 配置
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=your_token_here

# 点评评价图片来源链的生图凭据（new-api 站 api.mangoqwq.com，模型固定 gpt-image-2）。
# 不设置时 resolve_review_photos 跳过生图、直接回落默认图；key 只走 env，不入库。
# CLI 启动时会读取仓库根 `.env`（env.py load_dotenv）；已 export 的变量优先。
# 旧名 DIANPING_CPA_* 仍被识别（兼容既有本地 .env），但新配置请用 GEN 名。
DIANPING_GEN_API_KEY=sk-your_image_key_here
DIANPING_GEN_BASE_URL=https://api.mangoqwq.com/v1
DIANPING_GEN_IMAGE_MODEL=gpt-image-2
